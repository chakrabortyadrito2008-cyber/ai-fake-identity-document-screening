# Optional. Set only if tesseract.exe is not on PATH.
TESSERACT_PATH=
# Required only when api.require_api_key is true.
FRAUD_API_KEY=change-me
# Optional key for encrypted document storage (Fernet key).
FRAUD_STORAGE_KEY=
# Optional server-only key for signed, tamper-evident analysis receipts.
RECEIPT_SIGNING_KEY=
# Set to production when deployed behind HTTPS; keep development for local demos.
FRAUD_ENVIRONMENT=development
# A reviewer identifier is supplied as X-Operator-ID for human review decisions.
